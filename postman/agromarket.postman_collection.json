              "pm.test('Статус 201', () => {\r\n  pm.response.to.have.status(201);\r\n});\r\n\r\nconst body = pm.response.json();\r\n\r\npm.test('Роль user', () => {\r\n  pm.expect(body.user.role).to.eql('user');\r\n});\r\n\r\npm.test('Нет password_hash', () => {\r\n  pm.expect(body.user).to.not.have.property('password_hash');\r\n});\r\n\r\npm.collectionVariables.set('userToken', body.token);"
            ]
          }
